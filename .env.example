APP_NAME="AI Phishing Detection System"
API_PREFIX="/api/v1"
DATABASE_URL="sqlite:///./phishing_detection.db"
MODEL_PATH="trained_models/phishing_model.pkl"
TFIDF_PATH="trained_models/tfidf_vectorizer.pkl"
OPENROUTER_API_KEY="sk-or-v1-your-key-here"
# Comma-separated keys gating /history, /dashboard, /analytics. Unset = open dev mode.
API_KEYS=""
# Set to "false" to disable external AI explanations (local-only mode, no email text leaves the server).
AI_EXPLANATIONS_ENABLED="true"
