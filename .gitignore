# ─── Logs ───────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*

# ─── Dependencies ──────────────────────────────
node_modules/
.venv/
venv/
env/

# ─── Build output ──────────────────────────────
dist/
dist-ssr
*.local

# ─── Editor / IDE ──────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.sw?
.DS_Store
Thumbs.db

# ─── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Database ──────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Datasets (regenerated by build pipeline) ──
datasets/raw/
datasets/processed/*.csv
datasets/processed/*.pkl
datasets/final/*.csv
datasets/validation/*.csv

# ─── Trained models (binary artifacts) ─────────
trained_models/

# ─── Environment ──────────────────────────────
.env
.env.local

# ─── Reports / exports ────────────────────────
# Real evaluation artifacts in reports/ ARE tracked on purpose (see
# reports/README.md). Add new generated reports explicitly with `git add`.

